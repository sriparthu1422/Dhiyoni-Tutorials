{
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://dhiyoni-tutorials-lytx.vercel.app/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://dhiyoni-tutorials-lytx.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
